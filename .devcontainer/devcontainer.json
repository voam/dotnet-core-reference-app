// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	// Uses docker-compose.yml in this folder: "app" (built from the Dockerfile) and "mail" (MailHog).
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/first-app",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": ["mail:8025"],
	"portsAttributes": {
		"mail:8025": { "label": "MailHog UI" }
	},

	// Runs in WSL before every build: drops Docker's cached copy of the build folder
	// (only the file-transfer cache, not image layers, so apt stays cached) so the
	// Dockerfile's COPY of devcontainer-firewall.sh always gets the current file.
	"initializeCommand": "docker builder prune -f --filter type=source.local",

	// Lock down outbound network on every start (see devcontainer-firewall.sh).
	// waitFor makes VS Code hold off on extensions/terminals until the firewall is up.
	"postStartCommand": "sudo /usr/local/bin/devcontainer-firewall.sh",
	"waitFor": "postStartCommand",

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "dotnet restore",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit",
				"anthropic.claude-code"
			]
		}
	},

	"remoteUser": "vscode"
}
